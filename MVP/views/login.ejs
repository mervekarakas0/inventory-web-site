<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MERLIN INVENTORY - Giriş Yap</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --brand-dark: #052133;
            --brand-accent: #084a90;
            --bg-light: #f4f7f9;
        }

        body {
            background: linear-gradient(135deg, var(--brand-dark) 0%, #b0dfff 100%);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
        }

        .login-card {
            background: #ffffff;
            padding: 3rem;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 420px;
            transition: transform 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-5px);
        }

        /* Login Sayfası İçin Özel Logo Ayarı */
.brand-logo {
    /* Genişliği 240px'e çıkardık, sen istersen daha da artırabilirsin */
    max-width: 240px; 
    height: auto;
    margin-bottom: 2rem; 
    /* Logoyu ön plana çıkarmak için hafif bir parlama efekti */
    filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.2)); 
    transition: transform 0.4s ease;
    display: block;
    margin-left: auto;
    margin-right: auto;
}

.brand-logo:hover {
    transform: scale(1.08); /* Fare üzerine gelince hafifçe büyür */
}

/* Logonun içindeki bulunduğu kapsayıcıyı (wrapper) ferahlatıyoruz */
.logo-wrapper {
    padding: 10px 0;
}

        .login-title {
            color: var(--brand-dark);
            font-weight: 800;
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--brand-dark);
            margin-left: 2px;
        }

        .modern-input {
            border: 1.5px solid #e1e8ed;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.2s ease;
            background-color: #fcfdfe;
        }

        .modern-input:focus {
            outline: none;
            border-color: var(--brand-accent);
            box-shadow: 0 0 0 3px rgba(8, 74, 144, 0.1);
            background-color: #ffffff;
        }

        .login-btn {
            background-color: var(--brand-dark);
            border: none;
            color: white;
            padding: 0.8rem;
            border-radius: 10px;
            font-weight: 600;
            width: 100%;
            margin-top: 1rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .login-btn:hover {
            background-color: var(--brand-accent);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(5, 33, 51, 0.3);
        }

        .error-box {
            background-color: #fff5f5;
            border-left: 4px solid #fc8181;
            color: #c53030;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 12px;
            text-align: left; /* Metni sola yasla */
            width: 100%;      /* Kartın genişliğine tam yayıl */
            word-break: break-word; /* Uzun kelimeleri alt satıra at */
        }

        /* İkonun sıkışmasını engellemek için */
        .error-box i {
            flex-shrink: 0;
            font-size: 1.1rem;
        }

        .footer-text {
            margin-top: 2rem;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.6);
            text-align: center;
            position: absolute;
            bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="login-card text-center">
        <img src="/MS.png" alt="MERLIN Logo" class="brand-logo">
        
        <div class="login-title">MERLIN INVENTORY</div>
        <p class="login-subtitle">Lütfen devam etmek için giriş yapın.</p>

       <% if (locals.error && error.length > 0) { %>
    <div class="error-box">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span><%= error %></span> </div>
       <% } %>

        <form method="POST" action="/login" novalidate>
            <div class="mb-3 text-start">
                <label for="username" class="form-label">Kullanıcı Adı</label>
                <div class="input-group">
                    <input type="text" id="username" name="username" class="form-control modern-input" placeholder="Kullanıcı adınızı girin" required autofocus />
                </div>
            </div>

            <div class="mb-4 text-start">
                <label for="password" class="form-label">Şifre</label>
                <input type="password" id="password" name="password" class="form-control modern-input" placeholder="••••••••" required />
            </div>

            <button type="submit" class="login-btn">
                <span>Giriş Yap</span>
                <i class="bi bi-arrow-right"></i>
            </button>
        </form>
    </div>

    <div class="footer-text">
        © 2026 MERLIN INVENTORY SYSTEMS. Tüm hakları saklıdır.
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>