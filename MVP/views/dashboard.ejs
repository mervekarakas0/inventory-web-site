<%- include('partials/header') %>

<style>
  /* 1. Sayfa ve Tablo Konteynırı */
  .table-responsive {
      width: 100%;
      overflow-x: hidden !important; /* Kaydırmayı kapat */
      background: #fff;
      border-radius: 8px;
  }

  .modern-table { 
      width: 100% !important; 
      min-width: auto !important; 
      table-layout: fixed; /* Sütunları ekrana sığmaya zorlar */
      border-collapse: collapse; 
      margin: 0;
  }

  /* 2. Sığdırma İçin Kritik Yazı ve Boşluk Ayarları */
  .modern-table thead th {
      background-color: #001f3f !important;
      color: white !important;
      padding: 8px 2px !important; /* Boşlukları daralt */
      font-size: 0.72rem !important; /* Yazıları küçült */
      text-align: left;
      border: none;
      white-space: nowrap;
  }

  .modern-table td {
      padding: 6px 2px !important;
      font-size: 0.75rem !important; /* Veri yazılarını küçült */
      border-bottom: 1px solid #eee;
      vertical-align: middle;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis; /* Taşan yazıları 3 nokta yapar */
  }

  /* 3. Sütun Genişliklerini Manuel Paylaştırma (Toplam %100) */
  .col-foto { width: 3%; }
  .col-stok { width: 8%; }
  .col-pn { width: 8%; }
  .col-ana { width: 7%; }
  .col-alt { width: 7%; }
  .col-renk { width: 6%; }
  .col-ozel { width: 10%; }
  .col-ted { width: 6%; }
  .col-mik { width: 4%; }
  .col-bir { width: 5%; }
  .col-depo { width: 6%; }
  .col-raf { width: 6%; }
  .col-lot { width: 8%; }
  .col-kayit { width: 8%; }
  .col-islem { width: 8%; text-align: right; }

  /* Butonlar ve Görselleri Küçült */
  .action-btn { width: 28px !important; height: 28px !important; font-size: 0.8rem !important; border-radius: 6px; }
  .stock-img-container { width: 32px !important; height: 32px !important; border-radius: 4px; }
  .stock-img-container img { width: 100%; height: 100%; object-fit: cover; }

  /* Filtre Yapısı */
  .filter-container { width: 100%; overflow-x: auto; padding-bottom: 10px; }
  .filter-row { display: flex; flex-wrap: nowrap; gap: 4px; align-items: flex-end; }
  .filter-item { flex: 1; min-width: 100px; }
  .modern-input { font-size: 0.8rem; padding: 6px; width: 100%; border: 1px solid #ddd; border-radius: 6px; }
</style>

<div class="container-fluid px-2 my-4">
    <div class="modern-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="modern-title fs-5">Stok Yönetimi</h2>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Toplam: <%= stocks ? stocks.length : 0 %></span>
            </div>
        </div>

        <form action="/dashboard" method="GET" class="mb-3">
            <div class="filter-container">
                <div class="filter-row">
                    <div class="filter-item"><input type="text" name="stockCode" class="modern-input" placeholder="🔍 Stok Kodu" value="<%= filters?.stockCode %>"></div>
                    <div class="filter-item"><input type="text" name="manufacturerPN" class="modern-input" placeholder="🏭 Üretici P/N" value="<%= filters?.manufacturerPN %>"></div>
                    <div class="filter-item"><input type="text" name="feature" class="modern-input" placeholder="✨ Özellik" value="<%= filters?.feature %>"></div>
                    <div class="filter-item">
                        <select name="productTypeId" id="productTypeId" class="modern-input form-select">
                            <option value="">📦 Ürün Tipi</option>
                            <% if (productTypes) { productTypes.forEach(pt => { %>
                                <option value="<%= pt.ID %>" <%= filters?.productTypeId == pt.ID ? 'selected' : '' %>><%= pt.ProductName %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item">
                        <select name="subCategoryId" id="subCategoryId" class="modern-input form-select">
                            <option value="">📂 Alt Kat.</option>
                            <% if (subCategories) { subCategories.forEach(sc => { %>
                                <option value="<%= sc.ID %>" <%= filters?.subCategoryId == sc.ID ? 'selected' : '' %> data-product-type="<%= sc.ProductTypeID %>"><%= sc.SubCategory %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item">
                        <select name="colorId" class="modern-input form-select">
                            <option value="">🎨 Renk</option>
                            <% if (colors) { colors.forEach(c => { %>
                                <option value="<%= c.ID %>" <%= filters?.colorId == c.ID ? 'selected' : '' %>><%= c.ColorName %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item">
                        <select name="supplierCode" class="modern-input form-select">
                            <option value="">🚚 Tedarikçi</option>
                            <% if (suppliers) { suppliers.forEach(s => { %>
                                <option value="<%= s.SupplierCode %>" <%= filters?.supplierCode == s.SupplierCode ? 'selected' : '' %>><%= s.SupplierName %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item">
                        <select name="unitCode" class="modern-input form-select">
                            <option value="">📏 Birim</option>
                            <% if (units) { units.forEach(u => { %>
                                <option value="<%= u.UnitCode %>" <%= filters?.unitCode == u.UnitCode ? 'selected' : '' %>><%= u.UnitName %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item">
                        <select name="depo" class="modern-input form-select">
                            <option value="">🏢 Depo</option>
                            <% if (depos) { depos.forEach(d => { %>
                                <option value="<%= d.Depo %>" <%= filters?.depo === d.Depo ? 'selected' : '' %>><%= d.Depo %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item">
                        <select name="raf" class="modern-input form-select">
                            <option value="">🗄️ Raf</option>
                            <% if (raflar) { raflar.forEach(r => { %>
                                <option value="<%= r.Raf %>" <%= filters?.raf === r.Raf ? 'selected' : '' %>><%= r.Raf %></option>
                            <% })} %>
                        </select>
                    </div>
                    <div class="filter-item"><input type="date" name="startDate" id="startDate" class="modern-input" value="<%= filters?.startDate %>"></div>
                    <div class="filter-actions d-flex gap-1">
                        <button type="submit" class="btn-modern-primary" style="padding: 6px 10px; font-size: 0.8rem;">Filtrele</button>
                        <a href="/dashboard" class="action-btn btn-cancel-soft d-flex align-items-center justify-content-center">✕</a>
                    </div>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th class="col-foto">Foto</th> 
                        <th class="col-stok">Stok Kodu</th>
                        <th class="col-pn">Üretici P/N</th>
                        <th class="col-ana">Ana Kat.</th>
                        <th class="col-alt">Alt Kat.</th>
                        <th class="col-renk">Renk</th>
                        <th class="col-ozel">Özellik</th>
                        <th class="col-ted">Ted.</th>
                        <th class="col-mik">Mik.</th>
                        <th class="col-bir">Birim</th>
                        <th class="col-depo">Depo</th> 
                        <th class="col-raf">Raf</th> 
                        <th class="col-lot">Lot</th>
                        <th class="col-kayit">Kayıt Yapan</th> 
                        <th class="col-islem">İşlem</th> 
                    </tr>
                </thead>
                <tbody>
                    <% if (stocks && stocks.length > 0) { %>
                        <% stocks.forEach(stock => { %>
                            <tr>
                                <td>
                                    <% if (stock.UrunFotografiYolu) { %>
                                        <div class="stock-img-container" onclick="openImageModal('<%= stock.UrunFotografiYolu %>')">
                                            <img src="<%= stock.UrunFotografiYolu %>" alt="Ürün" onerror="this.src='/img/no-image.png'">
                                        </div>
                                    <% } else { %> - <% } %>
                                </td>
                                <td class="fw-bold"><%= stock.StockCode %></td>
                                <td><%= stock.ManufacturerPN %></td>
                                <td><%= stock.ProductTypes?.ProductName || '---' %></td>
                                <td><%= stock.SubCategories?.SubCategory || '---' %></td>
                                <td><%= stock.Colors?.ColorName || '---' %></td>
                                <td><%= stock.Feature %></td>
                                <td><%= stock.SupplierCode %></td>
                                <td><span class="badge bg-light text-dark" style="font-size: 0.7rem;"><%= stock.Quantity %></span></td>
                                <td><%= stock.Units?.UnitName || stock.UnitCode %></td>
                                <td><%= stock.Depo || '---' %></td>
                                <td><%= stock.Raf || '---' %></td>
                                <td class="text-muted"><%= stock.LotNo %></td>
                                <td><%= stock.RecordedBy || 'Sistem' %></td>
                                <td class="col-islem">
                                    <div class="d-inline-flex gap-1">
                                        <% if (user && user.canAddStock) { %>
                                            <button class="action-btn btn-edit-soft" data-bs-toggle="modal" data-bs-target="#editModal" data-stock-id="<%= stock.StockID %>" data-stock-json='<%= JSON.stringify(stock) %>'>✏️</button>
                                        <% } %>
                                        <% if (user && user.canDeleteStock) { %>
                                            <button type="button" class="action-btn btn-delete-soft" onclick="deleteStock('<%= stock.StockID %>')">🗑️</button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="15" class="text-center py-5 text-muted">Kayıtlı stok bulunamadı.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title modern-title fs-5 mb-0">Stok Kartı Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-4">
                <form id="editStockForm" enctype="multipart/form-data">
                    <input type="hidden" id="stockId" name="stockId">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label small text-muted">Stok Kodu</label><input type="text" class="modern-input bg-light" id="stockCode" name="stockCode" readonly></div>
                        <div class="col-md-6"><label class="form-label small text-muted">Üretici P/N</label><input type="text" class="modern-input bg-light" id="manufacturerPN" name="manufacturerPN" readonly></div>
                        <div class="col-md-4"><label class="form-label small text-muted">Lot No</label><input type="text" class="modern-input bg-light" id="lotNo" name="lotNo" readonly></div>
                        <div class="col-md-4"><label class="form-label small text-muted">Lot Tarihi</label><input type="text" class="modern-input bg-light" id="lotDate" name="lotDate" readonly></div>
                        <div class="col-md-4"><label class="form-label small text-muted">Üretici Lot</label><input type="text" class="modern-input bg-light" id="manufacturerLotNo" name="manufacturerLotNo" readonly></div>
                        <div class="col-12"><hr class="text-muted opacity-25"></div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Ana Kategori</label>
                            <select class="modern-input form-select" id="modalProductTypeId" name="productTypeId">
                                <option value="">Seç</option>
                                <% if (productTypes) { productTypes.forEach(pt => { %><option value="<%= pt.ID %>"><%= pt.ProductName %></option><% })} %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Alt Kategori</label>
                            <select class="modern-input form-select" id="modalSubCategoryId" name="subCategoryId">
                                <option value="">Seç</option>
                                <% if (subCategories) { subCategories.forEach(sc => { %><option value="<%= sc.ID %>" data-product-type="<%= sc.ProductTypeID %>"><%= sc.SubCategory %></option><% })} %>
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label fw-bold small">Miktar</label><input type="number" step="0.01" class="modern-input" id="quantity" name="quantity"></div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Birim</label>
                            <select class="modern-input form-select" id="unitCode" name="unitCode">
                                <% if (units) { units.forEach(u => { %><option value="<%= u.UnitCode %>"><%= u.UnitName %></option><% })} %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Renk</label>
                            <select class="modern-input form-select" id="modalColorId" name="colorId">
                                <option value="">Seç</option>
                                <% if (colors) { colors.forEach(c => { %><option value="<%= c.ID %>"><%= c.ColorName %></option><% })} %>
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Depo</label><input type="text" class="modern-input" id="warehouse" name="warehouse"></div>
                        <div class="col-md-6"><label class="form-label fw-bold small">Raf</label><input type="text" class="modern-input" id="shelf" name="shelf"></div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Fotoğraf Güncelle</label>
                            <input type="file" class="modern-input" name="urunFoto" accept="image/*" style="padding: 6px;">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="action-btn btn-cancel-soft" data-bs-dismiss="modal">✕</button>
                <button type="button" class="btn-modern-primary" id="saveEdit" style="width: auto; padding: 8px 25px;">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0 text-center">
                <img src="" id="fullSizeImage" class="img-fluid rounded shadow-lg" style="max-height: 85vh;">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
            </div>
        </div>
    </div>
</div>

<script>
    async function deleteStock(id) {
        if (!confirm('Silmek istediğinize emin misiniz?')) return;
        try {
            const res = await fetch(`/stocks/delete/${id}`, { method: 'POST' });
            const result = await res.json();
            if (res.ok) {
                showToast(result.message || "Kayıt silindi.", "success");
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast(result.error || "Silme hatası!", "error");
            }
        } catch (e) { 
            showToast("Sunucu iletişim hatası!", "error"); 
        }
    }

    function filterModalSubs(pId, sId, selected = '') {
        const pSelect = document.getElementById(pId);
        const sSelect = document.getElementById(sId);
        if(!pSelect || !sSelect) return;
        const pVal = pSelect.value;
        const options = sSelect.querySelectorAll('option[data-product-type]');
        sSelect.value = ""; 
        options.forEach(opt => {
            opt.style.display = (pVal === "" || opt.getAttribute('data-product-type') == pVal) ? 'block' : 'none';
        });
        if(selected) sSelect.value = selected;
    }

    const editModal = document.getElementById('editModal');
    if (editModal) {
        editModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            const stock = JSON.parse(btn.getAttribute('data-stock-json'));
            document.getElementById('stockId').value = btn.getAttribute('data-stock-id');
            document.getElementById('stockCode').value = stock.StockCode || '';
            document.getElementById('manufacturerPN').value = stock.ManufacturerPN || '';
            document.getElementById('lotNo').value = stock.LotNo || '';
            document.getElementById('lotDate').value = stock.LotDate ? stock.LotDate.split('T')[0] : '';
            document.getElementById('manufacturerLotNo').value = stock.ManufacturerLotNo || '';
            document.getElementById('modalProductTypeId').value = stock.ProductTypeID || '';
            document.getElementById('quantity').value = stock.Quantity || 0;
            document.getElementById('unitCode').value = stock.UnitCode || '';
            document.getElementById('warehouse').value = stock.Depo || '';
            document.getElementById('shelf').value = stock.Raf || '';
            document.getElementById('modalColorId').value = stock.ColorID || '';
            filterModalSubs('modalProductTypeId', 'modalSubCategoryId', stock.SubCategoryID);
        });
    }

    document.getElementById('modalProductTypeId')?.addEventListener('change', () => filterModalSubs('modalProductTypeId', 'modalSubCategoryId'));

    document.getElementById('saveEdit')?.addEventListener('click', async function() {
        const id = document.getElementById('stockId').value;
        const form = document.getElementById('editStockForm');
        const formData = new FormData(form); 
        const btn = this;
        btn.disabled = true;
        try {
            const res = await fetch(`/stocks/edit/${id}`, { method: 'POST', body: formData });
            const result = await res.json();
            if (res.ok) {
                showToast(result.message || "Başarıyla güncellendi.", "success");
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast(result.error || "Hata oluştu!", "error");
                btn.disabled = false;
            }
        } catch (e) { 
            showToast("Sunucu hatası!", "error"); 
            btn.disabled = false;
        }
    });

    document.getElementById('productTypeId')?.addEventListener('change', function() {
        const pId = this.value;
        const sSelect = document.getElementById('subCategoryId');
        sSelect.value = "";
        sSelect.querySelectorAll('option[data-product-type]').forEach(opt => {
            opt.style.display = (pId === "" || opt.getAttribute('data-product-type') == pId) ? 'block' : 'none';
        });
    });

    function openImageModal(src) {
        const modalImg = document.getElementById('fullSizeImage');
        modalImg.src = src;
        const myModal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
        myModal.show();
    }
</script>