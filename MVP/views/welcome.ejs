        <img src= alt="Envanter İkonu">
      </a>
      <a href="/dashboard" class="btn btn-primary inventory-btn">
        <img src= alt="Envanter İkonu">
      </a>
      <a href="/dashboard" class="btn btn-primary inventory-btn">
        <img src= alt="Envanter İkonu">
      </a>
    </div>
    <div class="button-row">
      <a href="/dashboard" class="btn btn-primary inventory-btn">
