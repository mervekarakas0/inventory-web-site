<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <link rel="icon" type="image/png" href="/MS.png?v=3">
  <link rel="shortcut icon" type="image/png" href="/MS.png?v=3">
  <link rel="apple-touch-icon" href="/MS.png?v=3">

  <title><%= typeof title !== 'undefined' ? title : 'MERLIN INVENTORY | Stok Takip Sistemi' %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <nav class="navbar navbar-expand-lg modern-navbar fixed-top">
    <div class="container-fluid">
      
      <a class="navbar-brand d-flex align-items-center" href="/dashboard">
        <img src="/MS.png" alt="Logo" width="30" height="30" class="me-2">
        <span class="fw-bold text-white" style="letter-spacing: 1px;">MERLIN INVENTORY</span>
      </a>

      <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <i class="bi bi-list fs-2"></i>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav align-items-center gap-1">
          
          <li class="nav-item">
            <a class="nav-link modern-link <%= typeof path !== 'undefined' && path === '/dashboard' ? 'active' : '' %>" href="/dashboard">
              <i class="bi bi-grid-fill"></i> Ana Sayfa
            </a>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link modern-link dropdown-toggle <%= typeof path !== 'undefined' && (path === '/productTypes' || path === '/subCategories' || path === '/attributes') ? 'active' : '' %>" 
               href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-collection-fill"></i> Kategori Tanımı
            </a>
            <ul class="dropdown-menu dropdown-menu-modern dropdown-menu-end">
              <li>
                <a class="dropdown-item dropdown-item-modern <%= typeof path !== 'undefined' && path === '/productTypes' ? 'active' : '' %>" href="/productTypes">
                  <i class="bi bi-box-seam"></i> Ana Kategoriler
                </a>
              </li>
              <li>
                <a class="dropdown-item dropdown-item-modern <%= typeof path !== 'undefined' && path === '/subCategories' ? 'active' : '' %>" href="/subCategories">
                  <i class="bi bi-list-nested"></i> Alt Kategoriler
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item dropdown-item-modern <%= typeof path !== 'undefined' && path === '/attributes' ? 'active' : '' %>" href="/attributes">
                  <i class="bi bi-palette2"></i> Renk ve Birim
                </a>
              </li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link modern-link <%= typeof path !== 'undefined' && path === '/stocks' ? 'active' : '' %>" href="/stocks">
              <i class="bi bi-box-arrow-in-down"></i> Stok Ekle
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link modern-link <%= typeof path !== 'undefined' && path === '/suppliers' ? 'active' : '' %>" href="/suppliers">
              <i class="bi bi-truck"></i> Tedarikçiler
            </a>
          </li>


          <li class="nav-item">
            <a class="nav-link modern-link <%= typeof path !== 'undefined' && path === '/users' ? 'active' : '' %>" href="/users">
              <i class="bi bi-people-fill"></i> Kullanıcılar
            </a>
          </li>

          <li class="nav-item d-none d-lg-block mx-2">
            <div style="width: 1px; height: 24px; background-color: rgba(255,255,255,0.2);"></div>
          </li>

          <li class="nav-item">
            <a class="nav-link modern-link text-danger" href="/logout" style="background-color: rgba(220, 53, 69, 0.1) !important; color: #ff6b6b !important;">
              <i class="bi bi-box-arrow-right"></i> Çıkış
            </a>
          </li>

        </ul>
      </div>
    </div>
  </nav>

  <main class="flex-grow-1">